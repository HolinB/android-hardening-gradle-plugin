package @PACKAGE@;

public final class Bridge {
    private static final byte[] KEY = java.util.Base64.getDecoder().decode("@KEY@");
    private static final byte[] MARKER = {72, 82, 68, 49};
    private static final String PREFIX = "@PREFIX@";
    private static final java.util.Set<String> ASSETS = new java.util.HashSet<String>(
        java.util.Arrays.asList(new String[] {@ASSETS@}));
    private Bridge() {}

    private static byte[] decrypt(byte[] input) throws java.security.GeneralSecurityException {
        if (input.length < 32 || !java.util.Arrays.equals(MARKER, java.util.Arrays.copyOfRange(input, 0, 4))) {
            throw new java.security.GeneralSecurityException("Invalid resource envelope");
        }
        javax.crypto.Cipher cipher = javax.crypto.Cipher.getInstance("AES/GCM/NoPadding");
        cipher.init(javax.crypto.Cipher.DECRYPT_MODE, new javax.crypto.spec.SecretKeySpec(KEY, "AES"),
            new javax.crypto.spec.GCMParameterSpec(128, java.util.Arrays.copyOfRange(input, 4, 16)));
        cipher.updateAAD(MARKER);
        return cipher.doFinal(input, 16, input.length - 16);
    }

    private static String decode(String text) {
        if (!text.startsWith(PREFIX)) return text;
        try {
            return new String(decrypt(java.util.Base64.getDecoder().decode(text.substring(PREFIX.length()))),
                java.nio.charset.StandardCharsets.UTF_8);
        } catch (java.security.GeneralSecurityException failure) {
            throw new IllegalStateException("Invalid protected string", failure);
        }
    }

    public static String string(android.content.Context context, int id) {
        return decode(context.getString(id));
    }
    public static String string(android.content.res.Resources resources, int id) {
        return decode(resources.getString(id));
    }
    public static String format(android.content.Context context, int id, Object[] args) {
        String text = context.getString(id);
        if (!text.startsWith(PREFIX)) return context.getString(id, args);
        return String.format(context.getResources().getConfiguration().getLocales().get(0), decode(text), args);
    }
    public static String format(android.content.res.Resources resources, int id, Object[] args) {
        String text = resources.getString(id);
        if (!text.startsWith(PREFIX)) return resources.getString(id, args);
        return String.format(resources.getConfiguration().getLocales().get(0), decode(text), args);
    }

    public static java.io.InputStream open(android.content.res.AssetManager assets, String path) throws java.io.IOException {
        if (path == null || ASSETS.isEmpty()) return assets.open(path);
        try {
            java.security.MessageDigest digest = java.security.MessageDigest.getInstance("SHA-256");
            digest.update(KEY);
            byte[] hash = digest.digest(path.getBytes(java.nio.charset.StandardCharsets.UTF_8));
            StringBuilder id = new StringBuilder(64);
            for (byte value : hash) {
                id.append(Character.forDigit((value >>> 4) & 15, 16));
                id.append(Character.forDigit(value & 15, 16));
            }
            if (!ASSETS.contains(id.toString())) return assets.open(path);
            byte[] envelope;
            int slash = path.lastIndexOf('/');
            String protectedPath = (slash < 0 ? "" : path.substring(0, slash + 1)) + "_h_" + id + ".bin";
            try (java.io.InputStream input = assets.open(protectedPath)) {
                java.io.ByteArrayOutputStream output = new java.io.ByteArrayOutputStream();
                byte[] buffer = new byte[8192];
                int count;
                while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
                envelope = output.toByteArray();
            }
            return new java.io.ByteArrayInputStream(decrypt(envelope));
        } catch (java.security.GeneralSecurityException failure) {
            throw new java.io.IOException("Invalid protected asset", failure);
        }
    }
}
